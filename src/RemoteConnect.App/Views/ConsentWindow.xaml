<Window x:Class="RemoteConnect.App.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteConnect — запрос доступа" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBrush}" ShowInTaskbar="True">
    <StackPanel Margin="24">
        <TextBlock Text="Запрос на управление компьютером" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}">
            <Run Text="«" /><Run x:Name="PeerName" FontWeight="SemiBold" /><Run Text="» получит доступ к экрану этого компьютера и сможет управлять мышью и клавиатурой." />
        </TextBlock>
        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
            <Run Text="Разрешайте, только если знаете этого человека. Код хоста: " /><Run x:Name="FingerprintRun" FontFamily="Consolas" />
        </TextBlock>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Отключить сессию можно в любой момент кнопкой на плашке вверху экрана." />
        <TextBlock x:Name="Countdown" Foreground="{StaticResource WarningBrush}" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="DenyButton" Content="Отклонить" MinWidth="110" Click="Deny_Click" IsCancel="True" />
            <Button Content="Разрешить" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="10,0,0,0" Click="Allow_Click" />
        </StackPanel>
    </StackPanel>
</Window>
