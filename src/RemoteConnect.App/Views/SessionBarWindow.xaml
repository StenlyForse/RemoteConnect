<Window x:Class="RemoteConnect.App.Views.SessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemoteConnect.App.Views"
        Title="RemoteConnect — сессия" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent">
    <!-- Панель чата — в том же окне под плашкой: поверх всех окон и перемещается вместе с ней (FR-CHT-20) -->
    <StackPanel>
        <Border CornerRadius="0,0,10,10" Padding="16,8" MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush x:Name="BarBrush" Color="#B91C1C" />
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center">
                    <Run Text="Ваш компьютер под управлением: " /><Run x:Name="PeerName" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock x:Name="FileStatus" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
                <ToggleButton x:Name="ViewOnly" Content="Только просмотр" Margin="16,0,0,0" Padding="10,4" Cursor="Hand"
                              Checked="ViewOnly_Changed" Unchecked="ViewOnly_Changed"
                              ToolTip="Запретить удалённый ввод: друг будет только видеть экран" />
                <ToggleButton x:Name="ClipboardToggle" Content="Буфер обмена" IsChecked="True" Margin="8,0,0,0" Padding="10,4" Cursor="Hand"
                              Checked="Clipboard_Changed" Unchecked="Clipboard_Changed"
                              ToolTip="Синхронизировать буфер обмена с собеседником (текст, картинки, файлы)" />
                <Button Content="Отключить" Margin="8,0,0,0" Padding="12,4" FontWeight="SemiBold" Click="Disconnect_Click" Cursor="Hand" />
                <Button x:Name="ChatButton" Margin="12,0,0,0" Padding="10,4" Cursor="Hand" Click="Chat_Click" ToolTip="Чат с собеседником">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,2,6,0" />
                            <TextBlock Text="Чат" VerticalAlignment="Center" />
                        </StackPanel>
                        <Ellipse x:Name="ChatUnreadDot" Width="10" Height="10" Fill="#DC2626" Stroke="White" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-13,0" Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="ChatContainer" HorizontalAlignment="Right" Width="320" Height="380" Margin="0,4,0,0"
                CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Visibility="Collapsed">
            <views:ChatPanel x:Name="Chat" Margin="1" />
        </Border>
    </StackPanel>
</Window>
