<Window x:Class="RemoteConnect.App.Views.SessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteConnect — сессия" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent">
    <Border Background="#B91C1C" CornerRadius="0,0,10,10" Padding="16,8" MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="SizeAll">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center">
                <Run Text="Ваш компьютер под управлением: " /><Run x:Name="PeerName" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock x:Name="FileStatus" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
            <ToggleButton x:Name="ViewOnly" Content="Только просмотр" Margin="16,0,0,0" Padding="10,4" Cursor="Hand"
                          Checked="ViewOnly_Changed" Unchecked="ViewOnly_Changed"
                          ToolTip="Запретить удалённый ввод: друг будет только видеть экран" />
            <ToggleButton x:Name="ClipboardToggle" Content="Буфер обмена" IsChecked="True" Margin="8,0,0,0" Padding="10,4" Cursor="Hand"
                          Checked="Clipboard_Changed" Unchecked="Clipboard_Changed"
                          ToolTip="Синхронизировать буфер обмена с собеседником (текст, картинки, файлы)" />
            <Button Content="Отключить" Margin="8,0,0,0" Padding="12,4" FontWeight="SemiBold" Click="Disconnect_Click" Cursor="Hand" />
        </StackPanel>
    </Border>
</Window>
